# Copy to backend/.env for local runs. Never commit the real file; .gitignore excludes it.
# All values are optional locally: without a database URL the app uses SQLite, without AI keys it reads messages by rules.

# DATABASE_URL=postgresql://user:password@host:5432/peti
# JWT_SECRET=a-long-random-string
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# DEMO_MODE=true
# SEED_ON_START=true
# COOKIE_SECURE=false
